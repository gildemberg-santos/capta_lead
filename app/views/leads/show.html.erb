<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2><i class="bi bi-person me-2 text-primary"></i>Lead ##<%= @lead.id %></h2>
    <p class="text-muted mb-0">Detalhes do lead e resultado da qualificação IA.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Editar", edit_lead_path(@lead), class: "btn btn-outline-secondary" %>
    <%= link_to "Voltar", leads_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Informações</h5>
      </div>
      <div class="card-body">
        <ul class="list-group list-group-flush">
          <li class="list-group-item border-0 py-3">
            <div class="d-flex justify-content-between">
              <span class="text-muted">Empresa</span>
              <span class="fw-semibold"><%= @lead.company.name %></span>
            </div>
          </li>
          <li class="list-group-item border-0 py-3">
            <div class="d-flex justify-content-between">
              <span class="text-muted">Demonstração</span>
              <span class="badge <%= @lead.demo? ? 'bg-warning' : 'bg-secondary' %>"><%= @lead.demo? ? "Sim" : "Não" %></span>
            </div>
          </li>
          <li class="list-group-item border-0 py-3">
            <div class="d-flex justify-content-between">
              <span class="text-muted">Criado em</span>
              <span class="fw-semibold"><%= l @lead.created_at, format: :long %></span>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-robot me-2"></i>Qualificação IA</h5>
      </div>
      <div class="card-body">
        <% if @lead.lead_qualification %>
          <div class="row mb-3">
            <div class="col-6">
              <p class="text-muted small mb-1">Status</p>
              <span class="badge bg-<%= @lead.lead_qualification.status_qualified? ? "success" : "secondary" %>">
                <%= @lead.lead_qualification.status.humanize %>
              </span>
            </div>
            <div class="col-6">
              <p class="text-muted small mb-1">Score</p>
              <span class="fw-semibold"><%= @lead.lead_qualification.score ? "%.3f" % @lead.lead_qualification.score : "—" %></span>
            </div>
          </div>
          <div class="mb-3">
            <p class="text-muted small mb-1">Confiança</p>
            <span class="badge bg-<%= case @lead.lead_qualification.confidence when "high" then "success" when "medium" then "warning" else "secondary" end %>">
              <%= @lead.lead_qualification.confidence.humanize %>
            </span>
          </div>
          <div class="mb-3">
            <p class="text-muted small mb-1">Modelo</p>
            <span class="badge bg-ia"><%= @lead.lead_qualification.model_version %></span>
          </div>
          <p class="text-muted small mb-2"><strong>Avaliado em:</strong> <%= @lead.lead_qualification.evaluated_at ? l(@lead.lead_qualification.evaluated_at, format: :long) : "—" %></p>

          <% if @lead.lead_qualification.outcome.present? %>
            <div class="alert alert-<%= @lead.lead_qualification.outcome == "won" ? "success" : "danger" %> border-0">
              <i class="bi bi-<%= @lead.lead_qualification.outcome == "won" ? "check-circle" : "x-circle" %> me-2"></i>
              <strong>Resultado comercial:</strong> <%= @lead.lead_qualification.outcome.humanize %>
            </div>
          <% else %>
            <div class="alert alert-warning border-0">
              <i class="bi bi-clock me-2"></i>
              <strong>Resultado comercial:</strong> Não preenchido pelo time comercial
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-4 text-muted">
            <i class="bi bi-robot" style="font-size: 3rem;"></i>
            <p class="mt-2">Este lead ainda não foi qualificado.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Respostas do Formulário</h5>
  </div>
  <div class="card-body">
    <% if @lead.form_fields.any? %>
      <div class="table-responsive">
        <table class="table table-striped table-sm mb-0">
          <thead>
            <tr>
              <th scope="col">Campo</th>
              <th scope="col" class="text-center">Tipo</th>
              <th scope="col">Valor</th>
            </tr>
          </thead>
          <tbody>
            <% @lead.form_fields.each do |field| %>
              <tr>
                <td><%= field["label"] %></td>
                <td class="text-center"><span class="badge bg-secondary"><%= field["type"] %></span></td>
                <td><%= field["value"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-3 text-muted">
        Nenhuma resposta de formulário.
      </div>
    <% end %>
  </div>
</div>

<% if @lead.lead_qualification %>
  <div class="card">
    <div class="card-header">
      <h5 class="mb-0"><i class="bi bi-search me-2"></i>Snapshot da Qualificação</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <h6 class="text-muted small text-uppercase mb-3">Respostas (após sanitização LGPD)</h6>
          <div class="json-pre"><%= JSON.pretty_generate(@lead.lead_qualification.answers_snapshot) %></div>
        </div>
        <div class="col-md-6">
          <h6 class="text-muted small text-uppercase mb-3">Critérios utilizados</h6>
          <div class="json-pre"><%= JSON.pretty_generate(@lead.lead_qualification.criteria_snapshot) %></div>
        </div>
      </div>
      <% if @lead.lead_qualification.error_message.present? %>
        <div class="alert alert-warning mt-3">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <strong>Erro:</strong> <%= @lead.lead_qualification.error_message %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
