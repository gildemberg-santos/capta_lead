<div class="row justify-content-center">
  <div class="col-lg-9">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2><i class="bi bi-pencil me-2 text-primary"></i>Editar Lead ##<%= @lead.id %></h2>
        <p class="text-muted mb-0">Atualize os dados e campos do formulário.</p>
      </div>
      <%= link_to "Voltar", leads_path, class: "btn btn-outline-secondary" %>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-text me-2"></i>Editar Dados do Lead</h5>
      </div>
      <div class="card-body p-4">
        <%= form_with model: @lead, local: true, data: { controller: "lead-form" } do |f| %>
          <% if @lead.errors.any? %>
            <div class="alert alert-danger mb-4">
              <i class="bi bi-exclamation-circle me-2"></i>
              <strong><%= pluralize(@lead.errors.count, "erro") %> impediu que este lead fosse atualizado:</strong>
              <ul class="mb-0 mt-2">
                <% @lead.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="row mb-4">
            <div class="col-md-6">
              <%= f.label :company_id, "Empresa", class: "form-label fw-bold" %>
              <%= f.collection_select :company_id, @companies, :id, :name, {}, class: "form-select" %>
            </div>

            <div class="col-md-6">
              <div class="d-flex align-items-center">
                <span class="badge bg-<%= @lead.company&.demo? ? 'warning' : 'success' %>">
                  <%= @lead.company&.demo? ? "Empresa Demo" : "Empresa Normal" %>
                </span>
              </div>
              <p class="form-text text-muted small">O status de demonstração é definido pela empresa selecionada.</p>
            </div>
          </div>

          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <%= f.label :form_fields, "Campos do Formulário (JSON)", class: "form-label fw-bold" %>
              <button type="button" class="btn btn-outline-secondary btn-sm" data-action="lead-form#toggleJson">
                <i class="bi bi-code-slash me-1"></i> Modo JSON
              </button>
            </div>
            
            <div id="fields-dynamic" class="mb-3">
              <%= render "leads/form_fields", f: f %>
            </div>

            <div id="fields-json" style="display: none;" class="mb-3">
              <%= f.text_area :form_fields, class: "form-control font-monospace", rows: 8, value: JSON.pretty_generate(@lead.form_fields) %>
              <p class="form-text text-muted small">Edite diretamente o JSON dos campos do formulário.</p>
            </div>
          </div>

          <div class="d-flex justify-content-between mt-5 pt-4 border-top">
            <%= link_to "Voltar", leads_path, class: "btn btn-outline-secondary" %>
            <%= f.submit "Atualizar Lead", class: "btn btn-primary px-4" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
