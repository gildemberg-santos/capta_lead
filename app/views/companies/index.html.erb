<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2><i class="bi bi-buildings me-2 text-primary"></i>Empresas</h2>
    <p class="text-muted mb-0">Gerencie as empresas cadastradas e seus critérios de qualificação.</p>
  </div>
  <%= link_to "Nova Empresa", new_company_path, class: "btn btn-primary" %>
</div>

<% if @companies.any? %>
  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th scope="col">Empresa</th>
              <th scope="col" class="text-center">Critérios</th>
              <th scope="col" class="text-center">Leads</th>
              <th scope="col" class="text-center">Demo</th>
              <th scope="col" class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @companies.each do |company| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                      <i class="bi bi-building text-muted"></i>
                    </div>
                    <div>
                      <div class="fw-semibold"><%= company.name %></div>
                      <div class="text-muted small">ID <%= company.id %></div>
                    </div>
                  </div>
                </td>
                <td class="text-center">
                  <% if company.qualification_criteria.any? %>
                    <span class="badge bg-secondary"><%= company.qualification_criteria.size %> critérios</span>
                  <% else %>
                    <span class="badge bg-light text-dark border">Padrão</span>
                  <% end %>
                </td>
                <td class="text-center"><%= company.leads.count %></td>
                <td class="text-center">
                  <%= check_box_tag nil, "1", company.demo, disabled: true, class: "form-check-input" %>
                </td>
                <td class="text-end">
                  <div class="btn-group">
                    <%= link_to company_path(company), class: "btn btn-sm btn-outline-primary", title: "Ver" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_company_path(company), class: "btn btn-sm btn-outline-secondary", title: "Editar" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to company_path(company), method: :delete, data: { confirm: "Tem certeza que deseja excluir esta empresa?" }, class: "btn btn-sm btn-outline-danger", title: "Excluir" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% else %>
  <div class="empty-state py-5">
    <i class="bi bi-buildings"></i>
    <h3>Nenhuma empresa cadastrada</h3>
    <p class="text-muted">Comece cadastrando sua primeira empresa para gerenciar leads e qualificações.</p>
    <%= link_to "Cadastrar Empresa", new_company_path, class: "btn btn-primary" %>
  </div>
<% end %>
